/* 提示條、黑幕、時鐘的樣式。 */

/* ── Toast：畫面上方冒一行字、飄一下就淡掉 ───────────────── */

.toast-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
}

.toast {
    position: absolute;
    top: 76px;                                  /* 原版是畫面高/2 - 96 */
    padding: 8px 24px;
    background-color: rgba(28, 24, 20, 0.89);
    border-width: 2px;
    border-color: rgba(224, 200, 160, 0.86);
    font-size: 20px;
    color: rgb(248, 238, 220);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ── 換場黑幕 ───────────────────────────────────────── */

.fade {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
}

/* ── 時鐘 ───────────────────────────────────────────── */

.clock {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 152px;                               /* 原版 D = 152 */
    height: 151px;                              /* D * 670/674 */
}

.clock-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

.clock-face {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* 指針：樞軸在底部的圓頭上，所以 transform-origin 往下移 */
.clock-hand {
    position: absolute;
    left: 50%;
}

.clock-icon {
    position: absolute;
    left: 50%;
}

/*
   盤面中央 Month / Day 那兩個格子裡的數字。
   ⚠️ 格子的底色是**深藍近黑**（見 ui/clock/face.png）—— 字一定要用亮色。
      原版是 rgb(244,228,176) 米金色、字級 D×0.15 = 23px、粗體。
      我一開始寫成深褐色 15px，結果深色字印在深色格子上，等於完全看不見。
*/
.clock-num {
    position: absolute;
    font-size: 23px;
    color: rgb(244, 228, 176);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.clock-text {
    position: absolute;
    left: 0; right: 0;
    bottom: -20px;
    font-size: 16px;
    color: rgb(248, 238, 220);
    -unity-text-align: middle-center;
}

.clock-date {
    position: absolute;
    left: -40px; right: 0;
    bottom: -40px;
    font-size: 15px;
    color: rgb(226, 214, 190);
    -unity-text-align: middle-right;
    white-space: nowrap;
}

/* ── 對話框 ─────────────────────────────────────────── */

.dlg-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    justify-content: flex-end;
    align-items: center;
}

.dlg-box {
    width: 84%;
    max-width: 760px;
    margin-bottom: 34px;
    flex-direction: row;
    background-color: rgba(26, 22, 30, 0.95);
    border-width: 3px;
    border-color: rgb(214, 196, 232);
    border-radius: 10px;
    padding: 14px 18px;
}

.dlg-portrait {
    width: 84px;
    height: 84px;
    margin-right: 14px;
    flex-shrink: 0;
    border-width: 2px;
    border-color: rgba(214, 196, 232, 0.5);
    border-radius: 6px;
}

.dlg-body { flex-grow: 1; }

.dlg-name {
    font-size: 19px;
    color: rgb(255, 226, 160);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.dlg-text {
    font-size: 20px;
    color: rgb(240, 236, 228);
    white-space: normal;
    min-height: 54px;
}

.dlg-choices { flex-direction: row; margin-top: 8px; }

.dlg-choice {
    height: 36px;
    padding: 0 18px;
    margin-right: 10px;
    background-color: rgb(78, 108, 122);
    color: rgb(244, 240, 232);
    border-width: 2px;
    border-color: rgba(228, 216, 198, 0.75);
    font-size: 17px;
}
.dlg-choice:hover { background-color: rgb(96, 130, 146); }

.dlg-next {
    font-size: 15px;
    color: rgb(176, 168, 190);
    -unity-text-align: middle-right;
    margin-top: 4px;
}

/* ── 任務簿（靠右的羊皮紙捲軸）───────────────────────── */

.quest-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.quest-scroll {
    width: 258px;                 /* 高 600 × 捲軸比例 0.43 */
    height: 600px;
    max-height: 96%;
    margin-right: 16px;
    padding: 58px 30px 46px 30px; /* 上下留給捲軸的木軸與捲邊 */
}

.quest-title {
    font-size: 24px;
    color: rgb(88, 52, 32);       /* 深墨色 —— 寫在羊皮紙上不能用淺色 */
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.quest-rule {
    height: 2px;
    background-color: rgba(120, 90, 60, 0.5);
    margin: 6px 4px 8px 4px;
}

.quest-list { flex-grow: 1; }

.quest-entry {
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(120, 90, 60, 0.28);
}

.quest-entry-title {
    font-size: 17px;
    color: rgb(88, 52, 32);
    -unity-font-style: bold;
    white-space: normal;
}

.quest-entry-obj {
    font-size: 14px;
    color: rgb(96, 70, 48);
    white-space: normal;
}

.quest-entry-sub {
    font-size: 13px;
    color: rgb(130, 104, 74);
    white-space: normal;
}

.quest-ready { color: rgb(150, 90, 30); -unity-font-style: bold; }

.quest-empty {
    font-size: 15px;
    color: rgb(96, 70, 48);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 40px;
}

.quest-foot {
    font-size: 13px;
    color: rgb(130, 104, 74);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.quest-close {
    position: absolute;
    top: 56px; right: 26px;
    width: 26px; height: 26px;
    background-color: rgb(150, 80, 70);
    color: rgb(248, 240, 228);
    border-width: 0;
    font-size: 14px;
}

/* ── 左上角常駐 HUD（金幣 + 名聲）───────────────────── */

.hud-corner {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: rgba(26, 22, 30, 0.72);
    border-width: 2px;
    border-color: rgba(224, 200, 160, 0.6);
    border-radius: 8px;
    padding: 8px 14px;
}

.hud-gold {
    font-size: 22px;
    color: rgb(255, 224, 130);
    -unity-font-style: bold;
    transform-origin: 0% 50%;     /* 字靠左，彈一下（UIAnim.Bump）時從左邊放大，不然字會左右晃 */
}
/* 金額變動時短暫閃一下（UIAnim.Bump 帶的 class；顏色的 transition 寫在 AnimStyle 的 .uia-bump）。
   ⚠️ 這裡不要再寫 transition-property，會把 .uia-bump 的 scale 動畫蓋掉。 */
.hud-gold--up   { color: rgb(170, 240, 150); }
.hud-gold--down { color: rgb(244, 150, 140); }

.hud-rep {
    font-size: 14px;
    color: rgb(206, 196, 178);
    margin-top: 2px;
}

/* 名聲進度條 */
.hud-bar {
    width: 140px;
    height: 6px;
    margin-top: 5px;
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: 3px;
}

.hud-bar-fill {
    height: 6px;
    background-color: rgb(255, 200, 110);
    border-radius: 3px;
}

/* ── 睡覺過場 ───────────────────────────────────────── */

.sleep-veil {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(10, 8, 16);
    align-items: center;
    justify-content: center;
}

.sleep-top {
    font-size: 24px;
    color: rgb(226, 214, 255);
    margin-bottom: 18px;
}

.sleep-witch { margin-bottom: 18px; }

.sleep-bottom {
    font-size: 20px;
    color: rgb(255, 232, 180);
}

/* ── 佈置模式的托盤（畫面下方那條）───────────────────── */

.tray-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    justify-content: flex-end;
    align-items: center;
}

.tray {
    width: 92%;
    max-width: 880px;
    margin-bottom: 16px;
    background-color: rgba(26, 22, 30, 0.94);
    border-width: 3px;
    border-color: rgb(214, 196, 232);
    border-radius: 10px;
    padding: 10px 14px;
}

.tray-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.tray-title {
    font-size: 18px;
    color: rgb(255, 226, 160);
    -unity-font-style: bold;
}

.tray-hint {
    font-size: 14px;
    color: rgb(186, 178, 168);
    margin-left: 14px;
    flex-grow: 1;
    white-space: normal;
}

.tray-items {
    flex-direction: row;
    flex-wrap: wrap;
    max-height: 148px;
}

.tray-item {
    width: 78px;
    height: 66px;
    margin: 3px;
    padding: 4px;
    background-color: rgba(70, 66, 62, 0.9);
    border-width: 2px;
    border-color: rgba(228, 216, 198, 0.65);
    border-radius: 6px;
    align-items: center;
}
.tray-item:hover { background-color: rgb(96, 90, 84); }

.tray-icon { width: 34px; height: 34px; }

.tray-name {
    font-size: 11px;
    color: rgb(238, 232, 222);
    -unity-text-align: middle-center;
    white-space: normal;
}

.tray-empty {
    font-size: 15px;
    color: rgb(176, 168, 158);
    -unity-text-align: middle-center;
    padding: 12px;
    white-space: normal;
}

/* ── 每日結算（睡醒時蓋在黑幕上的帳單）─────────────────── */

.day-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
}

.day-card {
    width: 90%;
    max-width: 520px;
    max-height: 88%;
    background-color: rgba(26, 22, 30, 0.96);
    border-width: 3px;
    border-color: rgb(214, 196, 232);
    border-radius: 12px;
    padding: 16px 22px 12px 22px;
}

.day-title {
    font-size: 24px;
    color: rgb(255, 226, 160);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.day-date {
    font-size: 15px;
    color: rgb(186, 178, 168);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.day-note {
    font-size: 14px;
    color: rgb(230, 140, 130);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
}

.day-rule {
    height: 1px;
    background-color: rgba(224, 200, 160, 0.28);
    margin: 10px 0 10px 0;
}

.day-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.day-key {
    font-size: 15px;
    color: rgb(206, 196, 178);
    flex-grow: 1;
}

.day-val {
    font-size: 16px;
    color: rgb(238, 232, 222);
    -unity-text-align: middle-right;
}

.day-plus  { color: rgb(160, 222, 150); }
.day-minus { color: rgb(230, 140, 130); }

.day-sub {
    font-size: 14px;
    color: rgb(186, 178, 168);
    margin-bottom: 4px;
}

.day-list {
    max-height: 168px;
    min-height: 40px;
}

.day-item {
    flex-direction: row;
    align-items: center;
    padding: 3px 2px 3px 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(224, 200, 160, 0.12);
}

.day-icon {
    width: 26px;
    height: 26px;
    margin-right: 8px;
}

.day-item-name {
    font-size: 14px;
    color: rgb(238, 232, 222);
    flex-grow: 1;
}

.day-item-qty {
    font-size: 13px;
    color: rgb(186, 178, 168);
    width: 46px;
    -unity-text-align: middle-right;
}

.day-item-gold {
    font-size: 14px;
    color: rgb(255, 224, 130);
    width: 72px;
    -unity-text-align: middle-right;
}

.day-empty {
    font-size: 14px;
    color: rgb(176, 168, 158);
    -unity-text-align: middle-center;
    padding: 12px;
    white-space: normal;
}

.day-net {
    font-size: 20px;
    color: rgb(255, 224, 130);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.day-gold {
    font-size: 14px;
    color: rgb(186, 178, 168);
    -unity-text-align: middle-right;
    margin-top: 2px;
}

.day-foot {
    font-size: 13px;
    color: rgb(150, 144, 138);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* ── 更新公告板（開遊戲時從上方滑下來的木框）───────────── */

.update-layer {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(20, 14, 26, 0.67);
    transition-property: opacity;
    transition-duration: 0.25s;
}

/* 關閉時整層淡掉（面板同時往上滑出去）*/
.update-root--closing .update-layer { opacity: 0; }

/* 寬高由 UpdatePanel.OnGeometry 依底圖比例設定，這裡只管外觀與動畫 */
.update-panel {
    background-size: 100% 100%;
    transition-property: translate, opacity;
    transition-duration: 0.55s;
    transition-timing-function: ease-out-back;
}

/* 關閉：換成反向的緩動，快一點 */
.update-panel--closing {
    transition-duration: 0.35s;
    transition-timing-function: ease-in-back;
}

/* 按著 OK 時整個面板微暗＝按鈕回饋（底圖上的 OK 是畫上去的，沒有自己的按下狀態）*/
.update-panel--press { opacity: 0.8; }

/* 退路：底圖載不到時至少有個素框，不開天窗 */
.update-panel--bare {
    background-color: rgb(238, 225, 196);
    border-width: 6px;
    border-color: rgb(120, 74, 42);
    border-radius: 8px;
}

/* 底圖上「米色內裡」的位置（量出來的比例，同 Cocos 版的 INNER）*/
.update-inner {
    position: absolute;
    left: 9.9%; right: 9.9%; top: 28.4%; bottom: 16.1%;
    padding-left: 3%;
    padding-right: 3%;
    /* 保險：就算自動縮字收斂不了，也絕不讓文字溢出去壓到木框 */
    overflow: hidden;
}

.update-date {
    color: rgb(126, 76, 44);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.update-body {
    color: rgb(74, 50, 38);
    -unity-text-align: upper-left;
    white-space: normal;
    flex-grow: 1;
}

/* 底圖上畫好的 OK 鈕的位置（同 Cocos 版的 OK_BTN），透明可點區 */
.update-ok {
    position: absolute;
    left: 38.9%; right: 39.0%; top: 86.1%; bottom: 2.8%;
}
